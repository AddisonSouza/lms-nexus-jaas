# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lms_db

# ── Redis ────────────────────────────────────────────────────
# Dev default matches docker-compose.yml default (redis-server --requirepass ${REDIS_PASSWORD:-redis})
REDIS_PASSWORD=redis

# ── JWT (RS256) ──────────────────────────────────────────────
# Dev: arquivos publicKey.pem / privateKey.pem em apps/api/src/main/resources/ (gerados para dev)
# Prod: configure as variáveis abaixo com o caminho dos arquivos externos ao repositório
# Gerar par de chaves: openssl genrsa -out private.pem 2048
#                      openssl pkcs8 -topk8 -inform PEM -in private.pem -out privateKey.pem -nocrypt
#                      openssl rsa -in private.pem -pubout -out publicKey.pem
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# ── Mail (SMTP) ──────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@lms.local
# Dev: use Mailpit (http://localhost:8025) — incluído no docker-compose.yml

# ── Storage (MinIO / S3) ─────────────────────────────────────
# Dev: MinIO via docker-compose (porta 9000, console 9001)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
STORAGE_BUCKET=lms-dev
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
# Prod: remova o endpoint-override do application.properties e configure:
# MINIO_ACCESS_KEY=<aws-access-key-id>
# MINIO_SECRET_KEY=<aws-secret-access-key>
# STORAGE_BUCKET=<bucket-name>
# STORAGE_REGION=<aws-region>
# STORAGE_PUBLIC_BASE_URL=https://<bucket>.s3.<region>.amazonaws.com

# ── Front-end ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
