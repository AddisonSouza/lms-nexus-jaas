# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lms_db

# ── Redis ────────────────────────────────────────────────────
# Dev default matches docker-compose.yml default (redis-server --requirepass ${REDIS_PASSWORD:-redis})
REDIS_PASSWORD=redis

# ── JWT (RS256) ──────────────────────────────────────────────
# Dev: arquivos publicKey.pem / privateKey.pem em apps/api/src/main/resources/ (gerados para dev)
# Prod: configure as variáveis abaixo com o caminho dos arquivos externos ao repositório
# Gerar par de chaves: openssl genrsa -out private.pem 2048
#                      openssl pkcs8 -topk8 -inform PEM -in private.pem -out privateKey.pem -nocrypt
#                      openssl rsa -in private.pem -pubout -out publicKey.pem
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# ── Mail (SMTP) ──────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@lms.local
# Dev: use Mailpit (http://localhost:8025) — incluído no docker-compose.yml

# ── Storage ──────────────────────────────────────────────────
STORAGE_PROVIDER=local
# Para S3/MinIO (futuro):
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# ── Front-end ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
