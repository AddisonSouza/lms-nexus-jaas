# ── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lms_db

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── JWT (RS256) ──────────────────────────────────────────────
# Gerar com: openssl genrsa -out private.pem 2048
# Nunca commitar os arquivos .pem — apenas injetar via variável
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Mail (SMTP) ──────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@lms.com

# ── Storage ──────────────────────────────────────────────────
STORAGE_PROVIDER=local
# Para S3/MinIO (futuro):
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# ── Front-end ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
