# Configuração de produção. Copie para infra/.env na VM e preencha.
#
#   cp infra/.env.prod.example infra/.env
#
# infra/.env nunca é commitado (ver .gitignore). As variáveis sem default fazem
# o compose recusar a subida se ficarem vazias — é de propósito: é melhor não
# subir do que subir com uma senha de desenvolvimento.
#
# Senhas: gere com `openssl rand -base64 32`.

# ── Domínio ──────────────────────────────────────────────────────────────────
# Sem o esquema e sem barra. O A record dele precisa apontar para o IP público
# da VM ANTES de rodar o init-letsencrypt.sh.
DOMAIN=lms.seudominio.com.br
# Para onde o Let's Encrypt avisa que o certificado está vencendo.
CERTBOT_EMAIL=voce@seudominio.com.br
# Deixe com qualquer valor enquanto estiver testando a emissão: o limite real é
# de 5 certificados por domínio por semana e queimá-lo custa dias de espera.
# Comente para emitir o certificado de verdade.
CERTBOT_STAGING=1

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lms_db
# A API se conecta com este usuário, não com root.
MYSQL_USER=lms
MYSQL_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── JWT (RS256) ──────────────────────────────────────────────────────────────
# Diretório no host com privateKey.pem e publicKey.pem, montado read-only no
# container. Gere um par NOVO na VM — as chaves que estão no histórico do
# repositório (c9123de) não servem:
#   mkdir -p infra/keys && cd infra/keys
#   openssl genrsa -out private.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -in private.pem -out privateKey.pem -nocrypt
#   openssl rsa -in private.pem -pubout -out publicKey.pem
#   rm private.pem && chmod 600 privateKey.pem
JWT_KEYS_DIR=./keys

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
# Brevo:  smtp-relay.brevo.com:587     Resend: smtp.resend.com:587
# A 587 exige STARTTLS, que o perfil %prod já liga.
# Configure SPF e DKIM no DNS do domínio, senão a confirmação de cadastro cai
# em spam — e sem ela ninguém consegue criar o primeiro usuário.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@seudominio.com.br

# ── Storage (OCI Object Storage, API S3-compatible) ──────────────────────────
# O namespace da tenancy aparece no console em Object Storage > Bucket Details.
STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
STORAGE_BUCKET=lms-prod
# ID da região da OCI, ex.: sa-saopaulo-1, us-ashburn-1.
STORAGE_REGION=sa-saopaulo-1
# Customer Secret Key, NÃO a chave de API da OCI. Console > seu usuário >
# Customer Secret Keys > Generate. O segredo só aparece uma vez.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Backup ───────────────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/lms
BACKUP_KEEP_DAYS=7
